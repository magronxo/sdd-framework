{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/magronxo/sdd-framework/contract/v1/feature-record.schema.json",
  "title": "Canonical SDD Feature Record v1",
  "description": "Canonical feature-record shape. Legacy aliases are accepted only for explicit tolerant reads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "state",
    "title",
    "created_at",
    "updated_at"
  ],
  "anyOf": [
    {
      "required": [
        "id"
      ]
    },
    {
      "required": [
        "feature_id"
      ]
    }
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/featureId"
    },
    "feature_id": {
      "allOf": [
        {
          "$ref": "#/$defs/featureId"
        }
      ],
      "deprecated": true,
      "description": "Legacy read alias for id. New writes must use id."
    },
    "type": {
      "const": "SYSTEM_SPEC"
    },
    "state": {
      "type": "string",
      "oneOf": [
        {
          "enum": [
            "DESIGN",
            "SPEC",
            "VALIDATION",
            "TASKS",
            "IMPLEMENT",
            "VERIFY",
            "AUDIT",
            "ARCHIVE"
          ],
          "title": "Canonical persistent state"
        },
        {
          "enum": [
            "DONE",
            "ARCHIVED"
          ],
          "title": "Legacy terminal-state alias",
          "deprecated": true
        }
      ],
      "x-canonical-values": [
        "DESIGN",
        "SPEC",
        "VALIDATION",
        "TASKS",
        "IMPLEMENT",
        "VERIFY",
        "AUDIT",
        "ARCHIVE"
      ],
      "x-legacy-aliases": {
        "DONE": "ARCHIVE",
        "ARCHIVED": "ARCHIVE"
      }
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "design_path": {
      "$ref": "#/$defs/artifactPath"
    },
    "spec_path": {
      "$ref": "#/$defs/artifactPath"
    },
    "task_path": {
      "$ref": "#/$defs/artifactPath"
    },
    "tasks_path": {
      "allOf": [
        {
          "$ref": "#/$defs/artifactPath"
        }
      ],
      "deprecated": true,
      "description": "Legacy read alias for task_path. New writes must use task_path."
    },
    "audit_report_path": {
      "$ref": "#/$defs/artifactPath"
    },
    "validation_result": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL"
      ],
      "x-canonical-values": [
        "PASS",
        "FAIL"
      ]
    },
    "validated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "validation_issues": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation_details": {
      "type": "string"
    },
    "verification_result": {
      "type": "string",
      "oneOf": [
        {
          "enum": [
            "PASS",
            "FAIL"
          ],
          "title": "Canonical verification result"
        },
        {
          "enum": [
            "PARTIAL",
            "PASS_WITH_FOLLOWUP"
          ],
          "title": "Historical non-canonical verification result",
          "deprecated": true
        }
      ],
      "x-canonical-values": [
        "PASS",
        "FAIL"
      ],
      "x-legacy-read-values": {
        "PARTIAL": null,
        "PASS_WITH_FOLLOWUP": "PASS"
      }
    },
    "verified_at": {
      "$ref": "#/$defs/timestamp"
    },
    "verification_details": {
      "type": "string"
    },
    "audit_result": {
      "type": "string",
      "enum": [
        "PASS",
        "WARN",
        "FAIL"
      ],
      "x-canonical-values": [
        "PASS",
        "WARN",
        "FAIL"
      ]
    },
    "audited_at": {
      "$ref": "#/$defs/timestamp"
    },
    "audit_reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "owner_waiver": {
      "$ref": "#/$defs/ownerWaiver"
    },
    "open_questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/openQuestion"
      },
      "uniqueItems": true
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "task_list": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sdt_scenarios": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "implementation_notes": {
      "type": "string"
    },
    "archived_at": {
      "$ref": "#/$defs/timestamp"
    },
    "archive_notes": {
      "type": "string"
    }
  },
  "dependentRequired": {
    "validation_result": [
      "validated_at"
    ],
    "verification_result": [
      "verified_at"
    ],
    "audit_result": [
      "audited_at"
    ]
  },
  "$defs": {
    "featureId": {
      "type": "string",
      "pattern": "^feat-[0-9]{3,}(?:-[a-z0-9]+(?:-[a-z0-9]+)*)?$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "artifactPath": {
      "type": "string",
      "oneOf": [
        {
          "pattern": "^docs/sdd/artifacts/(?!.*(?:^|/)\\.\\.(?:/|$)).*[^/]$",
          "title": "Canonical repository-relative artifact path"
        },
        {
          "pattern": "^artifacts/(?!.*(?:^|/)\\.\\.(?:/|$)).*[^/]$",
          "title": "Legacy sdd_root-relative artifact path",
          "deprecated": true
        }
      ],
      "x-canonical-prefix": "docs/sdd/artifacts/",
      "x-legacy-prefixes": [
        "artifacts/"
      ]
    },
    "openQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "blocking",
        "owner",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^Q-[0-9]{3,}$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "blocking": {
          "type": "boolean"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "OPEN",
            "RESOLVED"
          ]
        }
      }
    },
    "ownerWaiver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "waived_by",
        "waived_at",
        "reason"
      ],
      "properties": {
        "waived_by": {
          "type": "string",
          "minLength": 1
        },
        "waived_at": {
          "$ref": "#/$defs/timestamp"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
